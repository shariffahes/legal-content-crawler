MONGO_ROOT_USER=wrc
MONGO_ROOT_PASSWORD=placeholder
MONGO_HOST_PORT=27017
MONGO_URI=mongodb://wrc:placeholder@localhost:27017/?authSource=admin
MONGO_DB=legal_pipeline
MONGO_LANDING_COLLECTION=landing_records
MONGO_TRANSFORMED_COLLECTION=transformed_records

MINIO_ROOT_USER=wrc
MINIO_ROOT_PASSWORD=placeholder
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=wrc
S3_SECRET_KEY=placeholder
S3_REGION=us-east-1
S3_LANDING_BUCKET=landing
S3_TRANSFORMED_BUCKET=transformed

USER_AGENT=wrc-pipeline/0.1 (assessment project)
REQUEST_DELAY=0.6

PARTITION_SIZE=month

SOURCE_SPEC_PATH=config/sources/wrc.yml

CONCURRENT_REQUESTS=8
CONCURRENT_REQUESTS_PER_DOMAIN=4
DOWNLOAD_TIMEOUT=30
RETRY_TIMES=3
AUTOTHROTTLE_ENABLED=true
AUTOTHROTTLE_TARGET_CONCURRENCY=2.0
AUTOTHROTTLE_MAX_DELAY=30
ROBOTSTXT_OBEY=true
LOG_LEVEL=INFO
MAX_RECOVERY_PAGES=50

ORCHESTRATION_START_PARTITION=2010-01
# Dagster keeps run history under $DAGSTER_HOME, which it requires to be an absolute path,
# so it is set in the shell rather than here: export DAGSTER_HOME="$PWD/.dagster"
